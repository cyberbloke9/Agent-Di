<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- RECORD_AUDIO: the "Record" button captures speech and sends it to the
         server's Sarvam ASR, which transcribes Indic speech far better than the
         on-device recognizer. Requested at runtime before the first recording. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgentDi"
        android:usesCleartextTraffic="true">
        <!--
          usesCleartextTraffic is for the DEV setup only (http://localhost via
          `adb reverse`). Remove it (or restrict with a network-security-config)
          before any release build.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Assistant slot: once the user picks Agent-Di as the default Digital
          assistant app, the assist gesture (long-press home / power) starts
          AgentVoiceInteractionSession over any app. The session never moves money;
          a payment card is handed to MainActivity for the audited PIN flow.
        -->
        <service
            android:name=".assist.AgentVoiceInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>
        <service
            android:name=".assist.AgentVoiceInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <!-- Stub recognizer: required by the assistant registration; Agent-Di does STT server-side. -->
        <service
            android:name=".assist.AgentRecognitionService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <!--
          Reads incoming notifications so it can surface messages from the people
          the user marks important. The user must turn this on in system settings
          (Settings > Notifications > Notification access). Non-VIP and OTP-like
          messages are filtered ON DEVICE (NotificationTriage) and never leave the
          phone. A prominent in-app disclosure + consent must precede enabling
          this, per Google Play's User Data policy.
        -->
        <service
            android:name=".notifications.VipNotificationListener"
            android:exported="false"
            android:label="Agent-Di message watch"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
